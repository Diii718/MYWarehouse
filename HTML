  }

  openModal(`
    <h3>${isNew ? '添加' : '编辑'}${TYPE_LABEL[type] || ''}</h3>
    ${fields}
    <div class="modal-actions">
      ${isNew ? '' : '<button class="btn danger" id="f-del">删除</button>'}
      <span class="sp"></span>
      <button class="btn ghost" id="f-cancel">取消</button>
      <button class="btn" id="f-save">保存</button>
    </div>
  `);

  $('#f-cancel').onclick = closeModal;
  $('#f-save').onclick = async () => {
    const title = ($('#f-title')?.value || '').trim();
    const tags = ($('#f-tags')?.value || '').split(/[,，]/).map(s => s.trim()).filter(Boolean);
    const note = ($('#f-note')?.value || '').trim();

    const obj = { ...it, type, tags, note, updatedAt: Date.now() };
    if (!obj.createdAt) obj.createdAt = Date.now();
    if (!obj.id) obj.id = uid();

    if (type === 'image'){
      obj.title = title || '未命名';
      obj.source = ($('#f-source')?.value || '').trim();
    } else if (type === 'site'){
      const url = ($('#f-url')?.value || '').trim();
      if (!url){ toast('请填写网址', true); return; }
      obj.url = /^https?:\/\//i.test(url) ? url : 'https://' + url;
      if (!title){ try { obj.title = new URL(obj.url).hostname.replace(/^www\./, ''); } catch(e){ obj.title = obj.url; } }
      else obj.title = title;
    } else if (type === 'anime'){
      if (!title){ toast('请填写名称', true); return; }
      obj.title = title;
      obj.status = $('#f-status').value;
      obj.currentEp = Number($('#f-cur').value) || 0;
      obj.totalEp = Number($('#f-total').value) || 0;
    }

    await idbPut('items', obj);
    await loadAll();
    closeModal();
    renderNav(); renderTags(); renderContent();
    toast('已保存');
  };

  if (!isNew){
    const del = $('#f-del');
    if (del) del.onclick = async () => {
      if (!confirm('确定删除这条收藏吗？')) return;
      revokeURL(it.id);
      await idbDel('items', it.id);
      await loadAll();
      closeModal();
      renderNav(); renderTags(); renderContent();
      toast('已删除');
    };
    const coverBtn = $('#f-cover');
    if (coverBtn) coverBtn.onclick = () => {
      const inp = document.createElement('input');
      inp.type = 'file'; inp.accept = 'image/*';
      inp.onchange = async () => {
        const f = inp.files[0];
        if (!f) return;
        try {
          const {blob} = await compressImage(f);
          it.blob = blob;
          await idbPut('items', it);
          await loadAll();
          revokeURL(it.id);
          renderContent();
          toast('封面已更新');
        } catch(e){ toast('处理失败', true); }
      };
      inp.click();
    };
  }
}

