function drawChart(canvas, logs){
  const dpr = window.devicePixelRatio || 1;
  const w = canvas.clientWidth || 500;
  const h = canvas.clientHeight || 180;
  canvas.width = w * dpr;
  canvas.height = h * dpr;
  const ctx = canvas.getContext('2d');
  ctx.scale(dpr, dpr);
  ctx.clearRect(0, 0, w, h);

  // 按日期聚合（同一天取最后一条）
  const byDate = new Map();
  logs.forEach(l => byDate.set(l.date, l.value));
  const pts = [...byDate.entries()].sort((a, b) => a[0].localeCompare(b[0]));

  if (pts.length === 0){
    ctx.fillStyle = '#5c6478';
    ctx.font = '13px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('还没有数据', w / 2, h / 2);
    return;
  }

  const vals = pts.map(p => Number(p[1]));
  let min = Math.min(...vals), max = Math.max(...vals);
  if (min === max){ min -= 1; max += 1; }
  const padL = 44, padR = 12, padT = 14, padB = 24;
  const cw = w - padL - padR, ch = h - padT - padB;

  const xs = i => padL + (pts.length === 1 ? cw / 2 : cw * i / (pts.length - 1));
  const ys = v => padT + ch - ch * ((v - min) / (max - min));

  // 网格 + Y 轴
  ctx.strokeStyle = '#232a36';
  ctx.lineWidth = 1;
  ctx.fillStyle = '#5c6478';
  ctx.font = '10.5px sans-serif';
  ctx.textAlign = 'right';
  ctx.textBaseline = 'middle';
  for (let i = 0; i <= 4; i++){
    const v = min + (max - min) * i / 4;
    const y = ys(v);
    ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(w - padR, y); ctx.stroke();
    ctx.fillText(v.toFixed(1), padL - 8, y);
  }

  // 面积
  const grad = ctx.createLinearGradient(0, padT, 0, padT + ch);
  grad.addColorStop(0, 'rgba(79,140,255,.28)');
  grad.addColorStop(1, 'rgba(79,140,255,0)');
  ctx.beginPath();
  pts.forEach((p, i) => { i ? ctx.lineTo(xs(i), ys(Number(p[1]))) : ctx.moveTo(xs(i), ys(Number(p[1]))); });
  ctx.lineTo(xs(pts.length - 1), padT + ch);
  ctx.lineTo(xs(0), padT + ch);
  ctx.closePath();
  ctx.fillStyle = grad;
  ctx.fill();

  // 折线
  ctx.beginPath();
  pts.forEach((p, i) => { i ? ctx.lineTo(xs(i), ys(Number(p[1]))) : ctx.moveTo(xs(i), ys(Number(p[1]))); });
  ctx.strokeStyle = '#4f8cff';
  ctx.lineWidth = 2;
  ctx.lineJoin = 'round';
  ctx.stroke();

  // 点
  pts.forEach((p, i) => {
    ctx.beginPath();
    ctx.arc(xs(i), ys(Number(p[1])), 3, 0, Math.PI * 2);
    ctx.fillStyle = '#4f8cff';
    ctx.fill();
    ctx.strokeStyle = '#161a22';
    ctx.lineWidth = 1.5;
    ctx.stroke();
  });

  // X 轴首尾日期
  ctx.fillStyle = '#5c6478';
  ctx.textBaseline = 'top';
  ctx.textAlign = 'left';
  ctx.fillText(pts[0][0].slice(5), padL, h - 16);
  if (pts.length > 1){
    ctx.textAlign = 'right';
    ctx.fillText(pts[pts.length - 1][0].slice(5), w - padR, h - 16);
  }
}

/* =====================================================
   导出 / 导入
===================================================== */
async function exportAll(){
  const items = await idbGetAll('items');
  const plans = await idbGetAll('plans');
  const logs = await idbGetAll('logs');

  showProgress('正在打包数据…', 0);
  const out = {app: 'myVault', version: 1, exportedAt: new Date().toISOString(), items: [], plans, logs};
  for (let i = 0; i < items.length; i++){
    const it = {...items[i]};
    if (it.blob instanceof Blob){
      it.blobData = await blobToDataURL(it.blob);
      delete it.blob;
    }
    out.items.push(it);
    if (i % 5 === 0){
      setProgress(i / items.length);
      await new Promise(r => setTimeout(r, 0));
    }
  }
  setProgress(1);
  const json = JSON.stringify(out);
  const d = new Date();
  const name = `收藏库备份_${d.getFullYear()}${String(d.getMonth()+1).padStart(2,'0')}${String(d.getDate()).padStart(2,'0')}.json`;
  download(new Blob([json], {type: 'application/json'}), name);
  hideProgress();
  toast('备份已导出');
}

async function importAll(file, merge = true){
  const text = await file.text();
  let data;
  try { data = JSON.parse(text); } catch(e){ toast('文件格式不对', true); return; }
  if (!data || !Array.isArray(data.items)){ toast('这不是有效的备份文件', true); return; }

  if (!merge){
    if (!confirm('将清空现有全部数据，用备份覆盖。确定吗？')) return;
    await idbClear('items'); await idbClear('plans'); await idbClear('logs');
  }

  showProgress('正在导入…', 0);
  for (let i = 0; i < data.items.length; i++){
    const it = {...data.items[i]};
    if (it.blobData){
      try { it.blob = dataURLToBlob(it.blobData); } catch(e){}
      delete it.blobData;
    }
    await idbPut('items', it);
    if (i % 5 === 0){ setProgress(i / Math.max(1, data.items.length)); await new Promise(r => setTimeout(r, 0)); }
  }
  for (const p of (data.plans || [])) await idbPut('plans', p);
  for (const l of (data.logs || [])) await idbPut('logs', l);
  setProgress(1);

  state.urlCache.forEach(u => URL.revokeObjectURL(u));
  state.urlCache.clear();
  await loadAll();
  hideProgress();
  renderNav(); renderTags(); renderContent();
  toast('导入完成');
}

function showProgress(text, pct){
  $('#progText').textContent = text;
  $('#progBar').style.width = (pct * 100) + '%';
  $('#progress').style.display = 'flex';
}
function setProgress(pct){ $('#progBar').style.width = (pct * 100) + '%'; }
function hideProgress(){ $('#progress').style.display = 'none'; }

/* =====================================================
   添加按钮 —— 菜单
===================================================== */
function openAddMenu(){
  openModal(`
    <h3>添加内容</h3>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
      <button class="btn ghost" data-add="image" style="padding:20px 10px;font-size:14px">🖼️ 图片 / 视频</button>
      <button class="btn ghost" data-add="site" style="padding:20px 10px;font-size:14px">🔖 网站</button>
      <button class="btn ghost" data-add="anime" style="padding:20px 10px;font-size:14px">📺 动漫</button>
      <button class="btn ghost" data-add="plan" style="padding:20px 10px;font-size:14px">🎯 计划</button>
    </div>
    <div class="modal-actions"><span class="sp"></span><button class="btn ghost" id="a-cancel">取消</button></div>
  `);
  $('#a-cancel').onclick = closeModal;
  $$('[data-add]').forEach(b => {
    b.onclick = () => {
      const t = b.dataset.add;
      closeModal();
      if (t === 'image') $('#fileImages').click();
      else if (t === 'plan') openPlanEditor(null);
      else openItemEditor(t, null);
    };
  });
}

/* =====================================================
   批量添加图片
===================================================== */
async function addImages(files){
  const list = [...files];
  if (!list.length) return;
  showProgress(`处理中 0/${list.length}`, 0);
  let ok = 0, fail = 0;

  for (let i = 0; i < list.length; i++){
    const f = list[i];
    try {
      let thumb;
      if (f.type.startsWith('video/')) thumb = await grabVideoFrame(f);
      else if (f.type.startsWith('image/')) thumb = await compressImage(f);
      else { fail++; continue; }

      const item = {
        id: uid(),
        type: 'image',
        title: f.name.replace(/\.[^.]+$/, ''),
        blob: thumb.blob,
        w: thumb.w, h: thumb.h,
        isVideo: f.type.startsWith('video/'),
        tags: [], note: '', source: '',
        createdAt: Date.now(),
        updatedAt: Date.now(),
      };
      await idbPut('items', item);
      ok++;
    } catch(e){
      console.error(e);
      fail++;
    }
    setProgress((i + 1) / list.length);
    $('#progText').textContent = `处理中 ${i + 1}/${list.length}`;
    await new Promise(r => setTimeout(r, 0));
  }

  await loadAll();
  hideProgress();
  renderNav(); renderTags(); renderContent();
  toast(`完成：成功 ${ok} 个${fail ? '，失败 ' + fail + ' 个' : ''}`);
}

/* =====================================================
   事件绑定
===================================================== */
function bindUI(){
  // 侧栏导航
  $('#nav').addEventListener('click', e => {
    const btn = e.target.closest('button[data-view]');
    if (!btn) return;
    state.view = btn.dataset.view;
    state.tag = null;
    renderNav(); renderTags(); renderContent();
    $('#content').scrollTop = 0;
  });

  // 标签
  $('#tagList').addEventListener('click', e => {
    const chip = e.target.closest('[data-tag]');
    if (!chip) return;
    const t = chip.dataset.tag;
    state.tag = state.tag === t ? null : t;
    if (state.tag && state.view === 'plan') state.view = 'all';
    renderNav(); renderTags(); renderContent();
    $('#content').scrollTop = 0;
  });

  // 搜索
  let searchTimer;
  $('#search').addEventListener('input', e => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      state.search = e.target.value;
      renderContent();
    }, 160);
  });

  // 添加
  $('#btnAdd').onclick = openAddMenu;

  // 图片文件选择
  $('#fileImages').addEventListener('change', async e => {
    const files = e.target.files;
    e.target.value = '';
    await addImages(files);
  });

  // 内容区点击
  $('#content').addEventListener('click', e => {
    const editBtn = e.target.closest('[data-act="edit"]');
    if (editBtn){
      e.stopPropagation();
      const it = state.items.find(x => x.id === editBtn.dataset.id);
      if (it) openItemEditor(it.type, it);
      return;
    }
    const card = e.target.closest('.card, .plan-card');
    if (!card) return;
    const id = card.dataset.id;
    const act = card.dataset.act;
    if (act === 'plan'){ openPlanDetail(id); return; }
    const it = state.items.find(x => x.id === id);
    if (!it) return;
    if (act === 'view') openLightbox(it);
    else if (act === 'open'){ if (it.url) window.open(it.url, '_blank'); }
    else if (act === 'edit') openItemEditor(it.type, it);
  });

  // 无限滚动
  $('#content').addEventListener('scroll', () => {
    const el = $('#content');
    if (el.scrollTop + el.clientHeight > el.scrollHeight - 420){
      if (state.view !== 'plan' && state.shown < state.filtered.length){
        state.shown = Math.min(state.shown + state.pageSize, state.filtered.length);
        appendCards();
      }
    }
  });

  // 导出 / 导入
  $('#btnExport').onclick = exportAll;
  $('#btnImport').onclick = () => $('#fileImport').click();
  $('#fileImport').addEventListener('change', async e => {
    const f = e.target.files[0];
    e.target.value = '';
    if (!f) return;
    const merge = confirm('点「确定」= 合并导入（保留现有数据，同 ID 覆盖）\n点「取消」= 覆盖导入（清空后导入）');
    await importAll(f, merge);
  });

  // 灯箱
  $('#lightbox').addEventListener('click', () => {
    $('#lightbox').style.display = 'none';
    $('#lightbox').innerHTML = '';
  });

  // 快捷键
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape'){
      if ($('#lightbox').style.display === 'flex'){
        $('#lightbox').style.display = 'none';
        $('#lightbox').innerHTML = '';
      } else if ($('#modalRoot').style.display === 'block'){
        closeModal();
      }
    }
    if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA'){
      e.preventDefault();
      $('#search').focus();
    }
  });
}

function openLightbox(it){
  if (!it.blob){ openItemEditor(it.type, it); return; }
  const u = getURL(it);
  const lb = $('#lightbox');
  lb.innerHTML = `<img src="${u}" alt="">`;
  lb.style.display = 'flex';
}

/* =====================================================
   启动
===================================================== */
(async function init(){
  try {
    await openDB();
  } catch(e){
    console.error(e);
    document.body.innerHTML = `<div style="padding:50px;font-family:sans-serif;color:#e7eaf0;line-height:1.9;max-width:600px">
      <h2 style="margin-bottom:14px">无法初始化本地数据库</h2>
      <p>请使用 <b>Chrome</b> 或 <b>Edge</b> 浏览器打开这个文件。</p>
      <p style="color:#8b93a7;font-size:13px">如果用的是无痕模式，请换成普通窗口。</p>
      <p style="color:#8b93a7;font-size:13px">错误信息：${esc(String(e && e.message || e))}</p>
    </div>`;
    return;
  }
  await loadAll();
  bindUI();
  renderNav();
  renderTags();
  renderContent();

  if (location.protocol === 'file:'){
    console.log('本机模式运行中');
  }
})();
</script>
